@model ADPasswordManager.Models.ViewModels.SqlMappingViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Mapping</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 p-4">

    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-red-600 bg-red-50 p-3 rounded-md mb-4 border border-red-200"></div>

        <div class="mb-4">
            <label asp-for="OuDistinguishedName" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="OuDistinguishedName" class="mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md bg-gray-100" readonly />
            <span asp-validation-for="OuDistinguishedName" class="text-red-600 text-sm"></span>
        </div>

        <div class="mb-4">
            <label asp-for="SqlInstanceName" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="SqlInstanceName" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" placeholder="e.g., SERVER_NAME\INSTANCE_NAME" />
            <span asp-validation-for="SqlInstanceName" class="text-red-600 text-sm"></span>
        </div>
        <div class="flex items-center justify-end gap-4 border-t pt-4 mt-6">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
                Save Changes
            </button>
        </div>
    </form>

    @if (ViewBag.SaveSuccess == true)
    {
        <script>
            window.parent.postMessage('closeSqlMappingModal', '*');
        </script>
    }
</body>
</html>