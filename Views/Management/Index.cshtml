@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model ADPasswordManager.Models.ViewModels.UserManagementViewModel
@{
	ViewData["Title"] = "User Management";
}
<input type="hidden" id="RequestVerificationToken" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

<div id="reset-password-modal"
	 class="fixed inset-0 z-50 hidden"
	 role="dialog" aria-modal="true" aria-labelledby="reset-title" tabindex="-1">
	<div class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity"></div>
	<div class="relative h-full w-full flex items-center justify-center p-4">
		<div data-panel
			 class="w-full max-w-2xl  border border-gray-200   bg-gray-200 rounded-2xl shadow-2xl ring-1 ring-black/5 overflow-hidden transform transition duration-150 ease-out ">
			<div class="flex items-center justify-between px-5 py-4 border-b">
				<div class="flex items-center gap-3">
					<div class="h-9 w-9 inline-flex items-center justify-center rounded-xl bg-indigo-50">
						<svg class="h-5 w-5 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								  d="M12 11c.667-1.333 2-4 2-5a2 2 0 10-4 0c0 1 1.333 3.667 2 5zM6 21h12l-6-6-6 6z" />
						</svg>
					</div>
					<h3 id="reset-title" class="text-lg sm:text-xl font-semibold text-gray-900">
						Reset Password: <span id="modal-username" class="text-indigo-600 font-bold"></span>
					</h3>
				</div>
				<button id="close-modal-btn" type="button"
						class="inline-flex items-center justify-center rounded-xl p-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
						aria-label="Close">
					<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd"
							  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							  clip-rule="evenodd" />
					</svg>
				</button>
			</div>
			<div class="p-0">
				<iframe id="reset-password-iframe" src="about:blank"
						class="block w-full h-96 sm:h-[32rem]" frameborder="1"></iframe>
			</div>
		</div>
	</div>
</div>

<div id="create-user-modal"
	 class="fixed inset-0 z-50 hidden"
	 role="dialog" aria-modal="true" aria-labelledby="create-user-title" tabindex="-1">
	<div class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity"></div>
	<div class="relative h-full w-full flex items-center justify-center p-4">
		<div data-panel
			 class="w-full max-w-7xl  border border-gray-200   bg-gray-200 rounded-2xl shadow-2xl ring-1 ring-black/5 overflow-hidden transform transition duration-150 ease-out">
			<div class="flex items-center justify-between px-5 py-4 border-b">
				<div class="flex items-center gap-3">
					<div class="h-9 w-9 inline-flex items-center justify-center rounded-xl bg-indigo-50">
						<svg class="h-5 w-5 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								  d="M12 4v16m8-8H4" />
						</svg>
					</div>
					<h3 id="create-user-title" class="text-lg sm:text-xl font-semibold text-gray-900">
						New User
					</h3>
				</div>
				<button id="close-modal-create-btn" type="button"
						class="inline-flex items-center justify-center rounded-xl p-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
						aria-label="Close">
					<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd"
							  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							  clip-rule="evenodd" />
					</svg>
				</button>
			</div>
			<div class="p-0">
				<iframe id="create-user-iframe" src="about:blank"
						class="block w-full h-96 sm:h-[32rem]" frameborder="1"></iframe>
			</div>
		</div>
	</div>
</div>

