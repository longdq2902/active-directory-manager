@{
    Layout = null; // Trang này chạy trong iframe
    string username = ViewBag.Username ;
    string sqlInstance = ViewBag.sqlInstance;
    bool hasSqlAccess = ViewBag.HasSqlAccess; // Đây là trạng thái GỐC (trước khi gạt)
    string actionText = hasSqlAccess ? "REVOKE" : "GRANT";
    // Đặt màu cho nút "Confirm"
    string actionColor = hasSqlAccess ? "bg-red-600 hover:bg-red-700" : "bg-green-600 hover:bg-green-700";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #ffffff;
        }
    </style>
</head>
<body class="p-6">
    <div class="text-center">
        <h2 class="text-xl font-bold text-gray-900">Are you sure?</h2>
        <p class="mt-2 text-sm text-gray-600">
            You are about to <strong>@actionText</strong> SQL Access to account:
        </p>
        <p class="mt-1 text-lg font-medium text-gray-900">@username</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mt-4 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-md">
            @Html.ValidationSummary(false, "", new { @class = "list-disc list-inside" })
        </div>
    }

    <form asp-action="ToggleSqlAccess" method="post" class="mt-6">
        @Html.AntiForgeryToken()
        <input type="text" name="username" value="@username" />
        <input type="text" name="sqlInstance" value="@sqlInstance" />

        <div class="flex justify-center space-x-4">
            <button type"button" id="cancelButton"
                    class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50">
                Cancel
            </button>
            <button type="submit"
                    class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white @actionColor">
                Confirm @actionText
            </button>
        </div>
    </form>

    <script>
       
        // Gửi tin nhắn 'closeUserModal' về trang cha (Index.cshtml) khi nhấn Cancel
        document.getElementById('cancelButton').addEventListener('click', function() {
            window.parent.postMessage('closeUserModal', '*');
        });
    </script>
</body>
</html>