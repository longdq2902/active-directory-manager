@model ADPasswordManager.Models.ViewModels.PublicResetResultViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="text-center">
    @if (Model.IsSuccess)
    {
        <svg class="mx-auto h-12 w-12 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    }
    else
    {
        <svg class="mx-auto h-12 w-12 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    }

    <h3 class="mt-3 text-2xl font-bold text-gray-900">
        @Model.Title
    </h3>

    <div class="mt-2 text-sm text-slate-600">
        <p>
            @Model.Message
        </p>
    </div>

    @if (Model.IsSuccess)
    {
        <div class="mt-6">
            <a href="/"
               class="inline-flex items-center justify-center px-5 py-2.5 border border-transparent
                          text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700
                          focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Back to Login Page
            </a>
        </div>
    }
</div>